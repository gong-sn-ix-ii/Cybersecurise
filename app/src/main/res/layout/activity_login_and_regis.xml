<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawerLayout" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:gravity="center_vertical" android:orientation="vertical" android:id="@+id/topLayout" android:background="@drawable/bg_bottom_left_radius" android:layout_width="match_parent" android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="0">
            <ImageButton android:id="@+id/menuButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="75dp" android:contentDescription="TODO" android:backgroundTint="@android:color/transparent" app:srcCompat="@drawable/baseline_menu_24"/>
            <ImageView android:layout_gravity="center" android:id="@+id/imageView" android:layout_width="130dp" android:layout_height="155dp" app:srcCompat="@drawable/logo"/>
            <TextView android:textSize="16dp" android:textColor="@color/white" android:layout_width="match_parent" android:layout_height="31dp" android:layout_marginBottom="20dp" android:text="CYBERSECURISE" android:textAlignment="center"/>
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/login_submit" android:background="@color/white" android:paddingTop="75dp" android:layout_width="match_parent" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="0" app:layout_constraintTop_toBottomOf="@+id/topLayout">
            <LinearLayout android:orientation="vertical" android:paddingLeft="30dp" android:paddingRight="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:textSize="18dp" android:textColor="@color/white" android:id="@+id/nav_path_to_login" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="10dp" android:text="เข้าสู่ระบบ" android:textAllCaps="false" android:backgroundTint="#0f1426"/>
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:paddingLeft="30dp" android:paddingRight="30dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:textSize="18dp" android:textColor="@color/white" android:id="@+id/nav_path_to_register" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="สมัครบัญชี" android:backgroundTint="#0f1426"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.navigation.NavigationView android:layout_gravity="start" android:id="@+id/nav_view" android:fitsSystemWindows="true" android:layout_width="wrap_content" android:layout_height="match_parent" app:headerLayout="@layout/nav_header" app:menu="@menu/nav_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>
