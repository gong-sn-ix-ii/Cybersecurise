<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:layout_height="match_parent"
    android:id="@+id/drawerLayout"
    tools:context=".MainActivity">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <LinearLayout

            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bottom_left_radius"
            android:gravity="center_vertical"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/bottomLayout"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="50dp"
                android:backgroundTint="@android:color/transparent"
                app:srcCompat="@drawable/baseline_menu_24"
                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />


            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imageView"
                android:layout_width="130dp"
                android:layout_height="155dp"
                app:srcCompat="@drawable/logo"
                tools:layout_editor_absoluteX="137dp"
                tools:layout_editor_absoluteY="119dp" />

            <TextView
                android:textAlignment="center"
                android:layout_width="match_parent"
                android:layout_height="31dp"
                android:text="CYBERSECURISE"
                android:textColor="@color/white"
                android:textSize="16dp"
                android:layout_marginBottom="20dp"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topLayout"
            tools:layout_editor_absoluteX="0dp">

            <LinearLayout
                android:paddingLeft="40dp"
                android:paddingRight="40dp"
                android:orientation="vertical"
                android:background="@color/white"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="รายงาน"
                    android:textColor="@color/black"
                    android:textSize="24dp"
                    android:textStyle="bold"
                    />

                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="ชื่อผู้ก่อเหตุ"
                    />

                <EditText
                    android:textColor="@color/black"
                    android:id="@+id/name_culprit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/border_radius_report_screen"
                    android:hint="โปรดระบุชื่อ"
                    android:padding="10dp"
                    android:textColorHint="@color/Gray"
                    android:textSize="16dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:layout_marginTop="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="เลขบัญชีที่ผู้ก่อเหตุ"
                    />

                <EditText
                    android:textColor="@color/black"
                    android:id="@+id/bank_number_culprit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/border_radius_report_screen"
                    android:hint="xx-xxx-xxx"
                    android:padding="10dp"
                    android:textColorHint="@color/Gray"
                    android:textSize="16dp"
                    tools:ignore="TouchTargetSizeCheck" />
                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="เบอร์โทรศัพท์ผู้ก่อเหตุ"
                    />

                <EditText
                    android:textColor="@color/black"
                    android:id="@+id/phone_culprit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/border_radius_report_screen"
                    android:hint="0X-XXX-XXXX"
                    android:padding="10dp"
                    android:textColorHint="@color/Gray"
                    android:textSize="16dp"
                    tools:ignore="TouchTargetSizeCheck" />


                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="อธิบายเพิ่มเติม"
                    />

                <EditText
                    android:textColor="@color/black"
                    android:id="@+id/descript_culprit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="100dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/border_radius_report_screen"
                    android:hint="คำอธิบายเพิ่มเติม"
                    android:padding="10dp"
                    android:textColorHint="@color/Gray"
                    android:textAlignment="textStart"
                    android:textSize="16dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>


                <Button
                    android:layout_marginTop="5dp"
                    android:id="@+id/report_submit"
                    android:layout_width="130dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:backgroundTint="#0F1426"
                    android:text="รายงาน"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>




        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu"
        />


</androidx.drawerlayout.widget.DrawerLayout>
