<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="match_parent"
    tools:context=".Signout_Account">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:text="คุณต้องการออกจากบัญชี"
            android:textSize="18dp"
            android:textStyle="bold"
            android:layout_height="wrap_content"/>

        <TextView
            android:textColor="@color/white"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:id="@+id/email_current_user"
            android:layout_width="wrap_content"
            android:text="cyber.securise.dev@hotmail.com"
            android:textSize="18dp"
            android:textStyle="bold"
            android:layout_height="wrap_content"/>

        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:text="ใช่ หรือ ไม่"
            android:textSize="18dp"
            android:textStyle="bold"
            android:layout_marginBottom="100dp"
            android:layout_height="wrap_content"/>


    </LinearLayout>


    <LinearLayout
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Button
            android:textColor="@color/black"
            android:layout_marginLeft="10dp"
            android:id="@+id/wait_btn"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:text="ขอคิดดูก่อน"
            tools:ignore="MissingConstraints" />

        <Button
            android:layout_marginLeft="10dp"
            android:id="@+id/signout_submit"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/red"
            android:textColor="@color/white"
            android:text="Signout "
            tools:ignore="MissingConstraints" />


    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>