<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/GhostWhite"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_gravity="center"
            android:id="@+id/image"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_circle_black"
            android:scaleType="centerCrop"
            android:src="@drawable/quick1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/askBlock"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:text="ต้องการปลดบล็อค"
                android:textSize="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/name_sender_sms"
                android:textColor="@color/black"
                android:textAlignment="center"
                android:text="[Name]"
                android:textSize="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/black"
                android:textAlignment="center"
                android:text="หรือไม่"
                android:textSize="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


        </LinearLayout>


        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:padding="5dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Button
                    android:layout_marginRight="2.5dp"
                    android:id="@+id/unblocked_submit"
                    android:text="ปลดบล็อค"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/LimeGreen"
                    android:layout_width="130dp"
                    android:layout_height="50dp">
                </Button>

                <Button
                    android:layout_marginLeft="2.5dp"
                    android:id="@+id/blocked_cancle"
                    android:text="ยกเลิก"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/Red"
                    android:layout_width="130dp"
                    android:layout_height="50dp">
                </Button>

            </LinearLayout>




        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
